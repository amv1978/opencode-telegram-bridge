{
  "name": "opencode-bridge-desktop",
  "productName": "OpenCode Bridge",
  "version": "0.8.2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.opencode.telegram.bridge",
    "productName": "OpenCode Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  }
}
