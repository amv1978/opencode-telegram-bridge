<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ocbridge-cli</AssemblyName>
    <RootNamespace>OcbridgeCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <FileVersion>0.3.0</FileVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <!-- PublishSingleFile / SelfContained are passed on the command line, see README.md. -->
  </PropertyGroup>

</Project>
